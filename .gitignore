.venv/
__pycache__/
*.pyc
*.so
build/
dist/
*.egg-info/
.pytest_cache/
results/**/controller/*.zip

# Pre-flight run output (evodevo/preflight/): self-checks and real runs
# alike. This is generated harness output, never source -- see
# PREFLIGHT_READINESS.md and evodevo/preflight/__main__.py's own dirty-tree
# launch check, which excludes results/ from what must be committed before
# a real run for exactly this reason.
results/preflight/

# Nested repo with its own git history — tracked as a plain directory, not
# a submodule; its internals (including compiled build artifacts) are
# intentionally excluded from this outer repo.
external/evogym/

# Agent tooling scratch state (isolated worktrees created by coding-agent
# sessions), not project source.
.claude/

# Campaign-prep measurement output (P1/P2 prompts): generated, not source.
results/campaign_prep/
results/campaign/
campaign.local.yaml
CAMPAIGN_COMPLETE.txt

# Large derived views of the thermal study.  The final selection report,
# benchmark harness, analysis script and raw JSON telemetry are versioned;
# these can be regenerated from them.
results/thermal_worker_study/FINAL_SELECTION_*.json
results/thermal_worker_study/SELECTION_GATES_*

# Extension preflight output (python -m evodevo.extension preflight): generated, not source.
results/extension_preflight/

# macOS
.DS_Store
